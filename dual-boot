// prerequisites
//
disable bitlocker encryption
	find "Settings" in search box on task bar
	win\Settings\Privacy & Security\Device encryption
		turn off Device encryption							//re-enable after installation

disable "Fast Startup"
	find "Control Panel" in search box on task bar
	win\Control Panel\Hardware and Sound\Power Options
	select "Choose what the power buttons do"
		click "Change settings that are currently unavailable"
		deselect "Turn on fast startup"
		Save changes

install windows first

//
// rufus
//
drive properties_boot selection->*.iso
drive properties_partition scheme->GPT
start

//
// disk partitioning
//
find "Disk Management" in search box on task bar			//win+x disk management
	right-click on disk
	choose "Shrink Volume"

//
// UEFI
//
find "Settings" in search box on task bar
win\Settings\System\Recovery\Recovery options\Advanced startup
	restart now
Choose an option
	Use a device
		UEFI:Removable device

	//	option to BIOS
	//
	press esc, f2, or del as the system starts
		choose usb
	reboot

install linux
	select alongside windows boot manager

	// option to manually
	//
	select something else to manually set up				//option
		select unallocated space
		ext4												//root filesystem

